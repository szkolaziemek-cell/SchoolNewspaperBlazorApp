@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IAuthService authService
@inject IPermissionService permissionService
@inject INotificationService notificationService
@* Techniczny przycisk: tworzy konto testowe i nadaje mu uprawnienia administratora (tylko w trybie Development). *@
<button class="btn btn-dark btn-sm" @onclick="AddUser">ADD USER (TECHNICZNE)</button>

@code {

    public async Task AddUser()
    {
        string login = "admin123";
        string password = "admin123";
        string email = "admin123@admin.pl";

        // Rejestracja nie wymaga zalogowania. Jeśli konto już istnieje, serwis tylko to zgłosi.
        await authService.RegisterAsync(login, password, email);

        // Id konta pobieramy przez weryfikację hasła, więc działa też dla konta założonego wcześniej.
        var userId = await authService.CheckIfRegisteredAsync(email, password);
        if (userId == 0)
        {
            notificationService.Show("Nie znaleziono konta testowego lub hasło się nie zgadza.", EnumNotificationType.Failure);
            return;
        }

        await permissionService.BootstrapMasterAsync(userId);
    }
}
