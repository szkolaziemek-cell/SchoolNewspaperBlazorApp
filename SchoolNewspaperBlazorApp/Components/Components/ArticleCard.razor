@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Interfaces.Service
@* Karta działa w dwóch trybach: administracyjnym i publicznym. *@
<div class="article-grid">
    @foreach (var article in Articles)
    {
        if (Permissions == true)
        {
            <div class="article-card">
                <div class="article-card__img-wrap">
                    <img src="@GetImageUrl(DisplayFileId(article))" class="article-card__img" alt="@article.Title" loading="lazy">
                </div>
                <div class="article-card__body">
                    @if (article.IsEvent)
                    {
                        <span class="article-event-badge">📅 Wydarzenie@(article.EventDate != null ? " · " + article.EventDate.Value.ToString("dd.MM.yyyy, HH:mm") : "")</span>
                    }
                    else
                    {
                        <span class="article-news-badge">Aktualność</span>
                    }
                    <h5 class="article-card__title">@article.Title</h5>
                    @if (!string.IsNullOrEmpty(article.Tags))
                    {
                        <div class="article-tags">
                            @foreach (var tag in article.GetTagList())
                            {
                                <span class="article-tag">#@tag</span>
                            }
                        </div>
                    }
                    <p class="article-card__text">@article.Text</p>
                    <div class="article-card__footer">
                        <span class="article-card__byline">
                            <span class="article-card__author">@article.Author</span>
                            <time class="article-card__date">@article.PublishDate.ToString("dd.MM.yyyy, HH:mm")</time>
                        </span>
                        @if(CanDelete)
                        {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveArticleByIdAsync(article.Id)">
                            Usuń artykuł
                        </button>
                        }
                        <button class="btn btn-sm" @onclick="() => SendDataToEdit(article.Id)">
                            Edytuj artykul
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <NavLink class="article-card article-card--link" href="@($"/article/{article.Id}")">
                <div class="article-card__img-wrap">
                    <img src="@GetImageUrl(DisplayFileId(article))" class="article-card__img" alt="@article.Title" loading="lazy">
                </div>
                <div class="article-card__body">
                    @if (article.IsEvent)
                    {
                        <span class="article-event-badge">📅 Wydarzenie@(article.EventDate != null ? " · " + article.EventDate.Value.ToString("dd.MM.yyyy, HH:mm") : "")</span>
                    }
                    else
                    {
                        <span class="article-news-badge">Aktualność</span>
                    }
                    <h5 class="article-card__title">@article.Title</h5>
                    @if (!string.IsNullOrEmpty(article.Tags))
                    {
                        <div class="article-tags">
                            @foreach (var tag in article.GetTagList())
                            {
                                <span class="article-tag">#@tag</span>
                            }
                        </div>
                    }
                    <p class="article-card__text">@article.Text</p>
                    <div class="article-card__footer">
                        <span class="article-card__byline">
                            <span class="article-card__author">@article.Author</span>
                            <time class="article-card__date">@article.PublishDate.ToString("dd.MM.yyyy, HH:mm")</time>
                        </span>
                        <span class="article-card__more">Czytaj więcej →</span>
                    </div>
                </div>
            </NavLink>
        }
    }
</div>

@code {
    [Parameter]
    public EventCallback<int> OnEdit { get; set; }
    [Parameter]
    public List<Article> Articles { get; set; } = new();
    [Parameter]
    public bool Permissions { get; set; }
    [Parameter]
    public bool CanDelete { get; set; }
    [Inject]
    public required IArticleService articleService { get; set; }
    [Inject]
    public required IFileService fileService { get; set; }
    Dictionary<int, string> imageUrls = new Dictionary<int, string>();
    protected override async Task OnParametersSetAsync()
    {
        // Dociągamy tylko brakujące adresy zdjęć, więc filtrowanie listy nie odpytuje bazy od nowa.
        foreach (var article in Articles)
        {
            var displayId = DisplayFileId(article);
            if (imageUrls.ContainsKey(displayId))
            {
                continue;
            }
            try
            {
                var fileName = await fileService.GetFileNameByIdAsync(displayId);
                if (!string.IsNullOrWhiteSpace(fileName))
                {
                    imageUrls[displayId] = $"/Images/{fileName}";
                }
            }
            catch (Exception)
            {
                // Brak zdjęcia w bazie nie może przewrócić całej listy.
            }
        }
    }
    private static int DisplayFileId(Article article)
    {
        // Na liście pokazujemy okładkę, a gdy jej nie ma, zdjęcie główne.
        return article.CoverFileId ?? article.FileId;
    }
    private string GetImageUrl(int fileId)
    {
        // Brak adresu pozwala wyświetlić kartę także dla artykułu bez zdjęcia.
        return imageUrls.TryGetValue(fileId, out var url) ? url : "";
    }
    public async Task RemoveArticleByIdAsync(int id)
    {
        // Serwis decyduje o uprawnieniu i pokazuje komunikat; komponent usuwa kartę po sukcesie.
        var success = await articleService.RemoveArticleByIdAsync(id);
        if (success)
        {
            Article? article = Articles.FirstOrDefault(a => a.Id == id);
            if (article != null)
            {
                Articles.Remove(article);
            }
        }
    }
    public async Task SendDataToEdit(int id)
    {
        await OnEdit.InvokeAsync(id);
    }
}
