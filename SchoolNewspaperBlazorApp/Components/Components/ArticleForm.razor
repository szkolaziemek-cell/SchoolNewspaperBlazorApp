@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@inject IArticleService articleService
@inject IFileService fileService
@inject INotificationService notificationService

@* Formularz jest używany zarówno do tworzenia, jak i edycji artykułu. *@
<div class="add-article-form">
    <h1 class="add-article-form__title">Dodaj artykuł</h1>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (previewImage != null)
    {
        <div class="image-preview-wrap">
            <img src="@previewImage" alt="zdjęcie" class="image-preview" />
        </div>
    }
    <label class="form-label">Zdjęcie główne</label>
    <InputFile OnChange="ChoosePhoto" accept=".jpg,.jpeg,.png,.webp" class="form-control mb-1" />
    <div class="form-text mb-3">Dozwolone formaty: JPG, PNG, WEBP (maks. 5 MB).</div>

    @if (previewCover != null)
    {
        <div class="image-preview-wrap">
            <img src="@previewCover" alt="okładka" class="image-preview" />
        </div>
    }
    <label class="form-label">Zdjęcie okładkowe (opcjonalne)</label>
    <InputFile OnChange="ChooseCover" accept=".jpg,.jpeg,.png,.webp" class="form-control mb-1" />
    <div class="form-text mb-3">Okładka pojawia się na liście artykułów. Bez niej użyjemy zdjęcia głównego.</div>

    <form @onsubmit="SubmitForm" @onsubmit:preventDefault>
        <label class="form-label">Tytuł</label>
        <input @bind="title" class="form-control mb-3" placeholder="Wpisz tytuł..." />

        <label class="form-label">Treść</label>
        <textarea @bind="text" class="form-control mb-3" rows="6" placeholder="Treść artykułu..."></textarea>

        <label class="form-label">Autor</label>
        <input @bind="author" class="form-control mb-3" placeholder="Imię i nazwisko" />

        <label class="form-label">Hasztagi (opcjonalne)</label>
        <input @bind="tags" class="form-control mb-1" placeholder="np. sport, konkurs, wycieczka" maxlength="200" />
        <div class="form-text mb-3">Oddziel przecinkami lub spacjami. Maksymalnie 5 hasztagów, znak # nie jest potrzebny.</div>

        <label class="form-label">Rodzaj artykułu</label>
        <select @bind="articleType" class="form-control mb-3">
            <option value="@EnumArticleType.News">Aktualność</option>
            <option value="@EnumArticleType.Event">Wydarzenie</option>
        </select>

        @if (articleType == EnumArticleType.Event)
        {
            <label class="form-label">Data i godzina wydarzenia</label>
            <input type="datetime-local" @bind="eventDate" class="form-control mb-1" required />
            <div class="form-text mb-4">Wydarzenie trafi do zakładki Wydarzenia.</div>
        }
        else
        {
            <div class="form-text mb-4">Aktualność trafi do zakładki Aktualności.</div>
        }

        <button type="submit" class="btn btn-primary w-100">@(IsEdit ? "Zatwierdź edycje" : "Dodaj artykuł")</button>
    </form>
</div>


@code {
    [Parameter]
    public bool IsEdit { get; set; }
    [Parameter]
    public Article? Article { get; set;  }
    private string title = "";
    private string text = "";
    private string author = "";
    private string tags = "";
    private DateTime? eventDate;
    private EnumArticleType articleType = EnumArticleType.News;
    private string? previewImage;
    private string? previewCover;
    private string? errorMessage;
    IBrowserFile? file;
    IBrowserFile? coverFile;
    protected override void OnParametersSet()
    {
        // Podczas edycji wypełniamy formularz danymi przekazanymi przez panel administratora.
        if(IsEdit && Article != null)
        {
            title = Article.Title;
            text = Article.Text;
            author = Article.Author;
            tags = string.Join(", ", Article.GetTagList());
            eventDate = Article.EventDate;
            articleType = Article.ArticleType;
        }
    }
    private async Task SubmitForm()
    {
        // Nowy artykuł wymaga zdjęcia głównego; przy edycji zdjęcia mogą pozostać niezmienione.
        if(!IsEdit && file == null)
        {
            errorMessage = "Dodając artykuł, musisz dodać zdjęcie.";
            notificationService.Show(errorMessage, Data.Enums.EnumNotificationType.Failure);
            return;
        }
        if (articleType == EnumArticleType.Event && eventDate == null)
        {
            errorMessage = "Wydarzenie musi mieć ustawioną datę.";
            notificationService.Show(errorMessage, Data.Enums.EnumNotificationType.Failure);
            return;
        }
        try
        {
            int id = 0;
            int? coverId = null;
            if (file != null)
            {
                id = await fileService.UploadImage(file);
            }
            if (coverFile != null)
            {
                coverId = await fileService.UploadImage(coverFile);
            }
            if (IsEdit && Article != null)
            {
                // Przy edycji nowe zdjęcia są opcjonalne, a stare pozostają bez zmian.
                await articleService.UpdateArticleByIdAsync(Article.Id, title, text, author, id, coverId, tags, eventDate, articleType);
            }
            else
            {
                await articleService.AddArticleAsync(title, text, author, id, coverId, tags, eventDate, articleType);
            }
            errorMessage = null;
        }
        catch (InvalidOperationException ex)
        {
            // Komunikaty z FileService (brak uprawnień, zły plik) są przeznaczone dla użytkownika.
            errorMessage = ex.Message;
            notificationService.Show(ex.Message, Data.Enums.EnumNotificationType.Failure);
        }
        catch (Exception)
        {
            errorMessage = "Nie udało się zapisać zdjęcia.";
            notificationService.Show(errorMessage, Data.Enums.EnumNotificationType.Error);
        }
    }
    private async Task ChoosePhoto(InputFileChangeEventArgs e)
    {
        // Niepoprawny plik odrzucamy od razu, zanim trafi do zapisu.
        var error = await fileService.ValidateImageAsync(e.File);
        if (error != null)
        {
            file = null;
            previewImage = null;
            errorMessage = error;
            notificationService.Show(error, Data.Enums.EnumNotificationType.Failure);
            return;
        }
        errorMessage = null;
        file = e.File;
        previewImage = await fileService.GetPreviewAsync(file);
    }
    private async Task ChooseCover(InputFileChangeEventArgs e)
    {
        var error = await fileService.ValidateImageAsync(e.File);
        if (error != null)
        {
            coverFile = null;
            previewCover = null;
            errorMessage = error;
            notificationService.Show(error, Data.Enums.EnumNotificationType.Failure);
            return;
        }
        errorMessage = null;
        coverFile = e.File;
        previewCover = await fileService.GetPreviewAsync(coverFile);
    }
}
