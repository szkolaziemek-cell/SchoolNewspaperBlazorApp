@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service
@implements IDisposable
@inject INotificationService _notifyService
@* Popup nasłuchuje kolejki globalnego serwisu i wyświetla komunikaty po kolei. *@
@if(currentNotification != null)
{
<div class="notification-window notification-window--@currentNotification.Type?.ToString().ToLowerInvariant()" role="alert">
    <strong>@currentNotification.Message</strong>
</div>
}

@code {
    private int notificationKey;
    private NotificationMessage? currentNotification;
    private bool isProcessing;
    protected override void OnInitialized()
    {
        // Subskrypcja pozwala zareagować natychmiast po dodaniu nowego komunikatu.
        _notifyService.OnChange += HandleChange;
    }
    private void HandleChange()
    {
        _ = InvokeAsync(ProcessQueueAsync);
    }
    private async Task ProcessQueueAsync()
    {
        // Flaga chroni przed uruchomieniem kilku równoległych pętli obsługi.
        if (isProcessing)
            return;
        isProcessing = true;
        try
        {
            while(_notifyService.TryDequeue(out var notification))
            {
                currentNotification = notification;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(3000);
                currentNotification = null;
                await InvokeAsync(StateHasChanged);

            }
        }
        finally
        {
            isProcessing = false;
        }
       
    }
    public void Dispose()
    {
        // Odsubskrybowanie zapobiega wyciekom pamięci po opuszczeniu layoutu.
        _notifyService.OnChange -= HandleChange;

    }
}
