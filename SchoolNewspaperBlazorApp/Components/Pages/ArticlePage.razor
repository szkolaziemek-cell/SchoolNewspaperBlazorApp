@page "/article/{Id:int}"

@using SchoolNewspaperBlazorApp.Data
@using SchoolNewspaperBlazorApp.Data.Enums
@using SchoolNewspaperBlazorApp.Interfaces.Service

@* Strona szczegółów pobiera artykuł oraz opcjonalne zdjęcie na podstawie Id z adresu. *@
@if (article != null)
{
    <article class="article-page">

        @if (!string.IsNullOrEmpty(imageUrl))
        {
            <div class="article-page__img-wrap">
                <img src="@imageUrl" alt="@article.Title" class="article-page__img" />
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                Ten artykuł nie ma dodanego zdjęcia.
            </div>
        }

        <h1 class="article-page__title">@article.Title</h1>

        <div class="article-page__byline">
            <span class="article-page__author">@article.Author</span>
            <time class="article-page__date">@article.PublishDate.ToString("dd.MM.yyyy, HH:mm")</time>
        </div>

        @if (article.IsEvent)
        {
            <p class="article-event-badge">📅 Wydarzenie@(article.EventDate != null ? ": " + article.EventDate.Value.ToString("dd.MM.yyyy, HH:mm") : "")</p>
        }
        else
        {
            <p class="article-news-badge">Aktualność</p>
        }

        @if (!string.IsNullOrEmpty(article.Tags))
        {
            <div class="article-tags article-page__tags">
                @foreach (var tag in article.GetTagList())
                {
                    <span class="article-tag">#@tag</span>
                }
            </div>
        }


        <div class="article-page__content">
            @article.Text
        </div>

    </article>
}

@code {
    [Parameter]
    public int Id { get; set; }

    public Article? article;
    private string? imageUrl;

    [Inject]
    public IArticleService articleService { get; set; } = default!;

    [Inject]
    public IFileService fileService { get; set; } = default!;

    [Inject]
    public INotificationService notificationService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Najpierw pobieramy artykuł, a następnie szukamy jego pliku graficznego.
        article = await articleService.GetArticleByIdAsync(Id);

        if (article != null)
        {
            var fileName = await fileService.GetFileNameByIdAsync(article.FileId);
            if (!string.IsNullOrWhiteSpace(fileName))
            {
                imageUrl = $"/Images/{fileName}";
            }
            else
            {
                // Brak pliku nie blokuje czytania artykułu, ale powinien być widoczny dla użytkownika.
                notificationService.Show("Ten artykuł nie ma dodanego zdjęcia.", EnumNotificationType.Failure);
            }
        }
    }
}